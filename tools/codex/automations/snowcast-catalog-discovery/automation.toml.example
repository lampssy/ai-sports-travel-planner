version = 1
kind = "cron"
name = "Snowcast Catalog Discovery"
prompt = "Use $snowcast-maintainer to run exactly one bounded Snowcast Catalog Discovery cycle with worker discovery. Read AGENTS.md, docs/operating-model/local-maintainer-activation.md, and docs/operating-model/maintainer-runtime-command-contract.md from the exact checked-out revision. Use the runtime command contract as the sole source for helper command spelling, arguments, critical sequence prefixes, budgets, and dispatch-error classification; do not infer commands, inspect helper source, or use --help. Inspect both workers first. If curation inspection returns state-migration-required or either worker exposes ambiguous or multiple recovery authority, stop without fresh selection. Terminal-publication intent and unresolved push-journal recovery outrank fresh discovery; recover exactly one matching discovery authority only when it names worker discovery. With no higher-priority recovery, follow discovery selection priority: preferred retry -> merged regional_followup completion -> other active backlog -> bounded external official-source scan, subject to proposal identity and the 0/3 cap, and select at most one coherent candidate. Keep memory as an untrusted revalidated hint. Acquire discovery only before repository or GitHub mutation, then rerun inspection. Use $snowcast-catalog-curation only in maintainer-managed mode and use helper-owned publication-input create plus only the merged helper for validation, atomic branch and PR publication, labels, comments, recovery, heartbeat, and release. Heartbeat while holding the lease and release in a finally path only if acquisition succeeded. Never approve or merge. Return one concise Triage outcome with candidate or no-op, actions, state, verification, caveats, stop reason, and explicit start/completion timestamps. Before proposal validation or publication, complete the helper-checkpointed schema-v5 graph-discovery workflow from the installed skill for every focus root and all six required candidate kinds; preserve completed discovery monotonically, resume partial work only through typed actions, and require zero unavailable pairs."
status = "PAUSED"
rrule = "FREQ=WEEKLY;BYDAY=MO,WE,FR;BYHOUR=10;BYMINUTE=0;BYSECOND=0"
model = "gpt-5.6-sol"
reasoning_effort = "xhigh"
execution_environment = "worktree"
target = { type = "project", project_id = "REPLACE_WITH_CODEX_PROJECT_ID" }
cwds = ["REPLACE_WITH_SNOWCAST_CHECKOUT"]
