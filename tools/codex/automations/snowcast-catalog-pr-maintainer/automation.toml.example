version = 1
kind = "cron"
name = "Snowcast Catalog PR Maintainer"
prompt = "Use $snowcast-maintainer to run exactly one bounded Snowcast Catalog PR Maintainer cycle with worker curation. Read AGENTS.md, docs/operating-model/local-maintainer-activation.md, and docs/operating-model/maintainer-runtime-command-contract.md from the exact checked-out revision. Use the runtime command contract as the sole source for helper command spelling, arguments, critical sequence prefixes, budgets, and dispatch-error classification; do not infer commands, inspect helper source, or use --help. If inspect curation returns state-migration-required, stop without acquiring a lease because migration is owner activation work, not scheduled-cycle work. Inspect both workers first. Follow curation recovery priority exactly: terminal publication -> push journal -> post-push CI continuation -> current curation generation -> ordinary PR. Recover exactly one matching terminal-publication intent or unresolved push journal before fresh work; ambiguous or multiple recovery records stop. For post-push CI continuation, use the helper-owned same-lease or successor flow with cumulative 30/60/30 budgets, at most one fresh-reviewed test-only repair under tests/test_*.py, no local execution of target-PR tests, and no semantic work after the initial push. For current generations and ordinary PRs, acquire curation before mutation, run only registered recipes, obey returned generation next_action, use exact prepare-time base checkouts for checkpoint and validation, and use helper-owned publication-input create for every trusted title, body, and summary. Keep candidate inventory, assertion-level finding ledger, and automation memory separate and untrusted. Before semantic review, complete the helper-checkpointed schema-v5 graph-discovery workflow from the installed skill. Resume partial discovery only through typed actions, preserve completed discovery monotonically, and use legacy inventory completion only for an explicit helper-returned recovery. Before any discovery fixer, partition discovery findings from ordinary-remediation findings: pass only report-owned graph corrections, retain every non-report finding as open, preflight staged, unstaged, untracked, and cumulative-diff scope for exactly the canonical report pair, and route retained fixes through checkpoint_curation_delta only after the helper accepts the discovery checkpoint and both fresh review lanes complete. Apply the residual and exact-repeat rules from the installed skill. Heartbeat while holding the lease and release in a finally path only if acquisition succeeded. Never approve or merge. Return one concise Triage outcome with selected item or no-op, actions, state, verification, finding-family counts when applicable, residual count, maximum repeat streak, graph-discovery checkpoint progress when applicable, caveats, stop reason, and explicit start/completion timestamps."
status = "PAUSED"
rrule = "RRULE:FREQ=WEEKLY;BYHOUR=4;BYMINUTE=0;BYDAY=SU,MO,TU,WE,TH,FR,SA"
model = "gpt-5.6-sol"
reasoning_effort = "xhigh"
execution_environment = "worktree"
target = { type = "project", project_id = "REPLACE_WITH_CODEX_PROJECT_ID" }
cwds = ["REPLACE_WITH_SNOWCAST_CHECKOUT"]
