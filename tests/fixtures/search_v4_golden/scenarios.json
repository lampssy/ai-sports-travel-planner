            {"factor_id": "pass_terrain_value", "utility": 0.4}
          ]
        },
        {
          "id": "large-expensive",
          "evaluations": [
            {"factor_id": "pass_price_per_day", "utility": 0.3},
            {"factor_id": "pass_terrain_value", "utility": 0.9}
