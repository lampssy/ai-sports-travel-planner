{
  "cases": [
    {
      "name": "all_groups_normal_budget",
      "rationale": "Every default group is active and receives its documented 30/30/15/10/10/5 share.",
      "intent": {
        "factor_preferences": [
          {"factor_id": "local_pace", "mode": "prefer", "values": ["quiet"], "importance": "normal"}
        ],
        "objectives": [
          {"factor_id": "pass_terrain_value", "importance": "normal"}
        ]
      },
      "candidates": [
        {
          "id": "complete",
          "evaluations": [
            {"factor_id": "trip_window_snow_fit", "utility": 1},
            {"factor_id": "accessible_terrain_scale", "utility": 1},
            {"factor_id": "stay_base_access", "utility": 1},
            {"factor_id": "pass_terrain_value", "utility": 1},
            {"factor_id": "local_pace", "utility": 1},
            {"factor_id": "travel_effort", "utility": 1}
          ]
        }
      ],
      "expected_order": ["complete"],
      "expected_fit_ranges": {"complete": [99.99, 100.0]},
      "expected_group_shares": {
        "trip_viability": 0.30,
        "ski_experience": 0.30,
        "stay_practicality": 0.15,
        "value": 0.10,
        "character": 0.10,
        "travel_effort": 0.05
      }
    },
