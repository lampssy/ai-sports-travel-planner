    {
      "name": "advanced_party_does_not_imply_freeride",
      "rationale": "Advanced ability activates party skill coverage but never activates the independent marked-freeride preference.",
      "intent": {"party": {"skill_levels": ["advanced"]}},
      "candidates": [
        {
          "id": "on-piste-advanced",
          "evaluations": [
            {"factor_id": "accessible_terrain_scale", "utility": 0.8},
            {"factor_id": "party_skill_coverage", "utility": 0.7},
            {"factor_id": "marked_freeride_routes", "utility": 1}
          ]
        }
      ],
      "expected_order": ["on-piste-advanced"],
      "expected_fit_ranges": {"on-piste-advanced": [75.99, 76.01]},
      "expected_factor_ids": ["accessible_terrain_scale", "party_skill_coverage"]
    },
    {
      "name": "unknown_unavailable_and_sparse_positive_evidence",
      "rationale": "Unknown remains neutral, explicit unavailability is a miss, and weak positive evidence shrinks toward neutral.",
      "intent": {
        "factor_preferences": [
          {"factor_id": "night_skiing", "mode": "prefer", "importance": "normal"}
        ]
      },
      "candidates": [
        {
          "id": "weak-positive",
          "evaluations": [
            {"factor_id": "accessible_terrain_scale", "utility": 0.5},
            {"factor_id": "night_skiing", "utility": 1, "evidence_cap": 0.25}
          ]
        },
        {
          "id": "unknown",
          "evaluations": [
            {"factor_id": "accessible_terrain_scale", "utility": 0.5},
            {"factor_id": "night_skiing", "utility": 0.5, "evidence_cap": 0}
          ]
        },
        {
          "id": "unavailable",
          "evaluations": [
            {"factor_id": "accessible_terrain_scale", "utility": 0.5},
            {"factor_id": "night_skiing", "utility": 0, "evidence_cap": 1}
          ]
        }
      ],
      "expected_order": ["weak-positive", "unknown", "unavailable"],
      "expected_fit_ranges": {
        "weak-positive": [54.99, 55.01],
        "unknown": [49.99, 50.01],
        "unavailable": [29.99, 30.01]
      }
    },
    {
      "name": "intensity_qualified_apres",
      "rationale": "A lively ski-day apres request rewards the matching intensity rather than any generic bar evidence.",
      "intent": {
        "factor_preferences": [
          {"factor_id": "ski_day_apres", "mode": "prefer", "values": ["lively"], "importance": "normal"}
        ]
      },
      "candidates": [
        {"id": "lively", "evaluations": [{"factor_id": "ski_day_apres", "utility": 1}]},
        {"id": "low-key", "evaluations": [{"factor_id": "ski_day_apres", "utility": 0}]}
      ],
      "expected_order": ["lively", "low-key"],
      "expected_fit_ranges": {"lively": [99.99, 100.0], "low-key": [0, 0.01]}
    },
    {
      "name": "pass_objective_comparability",
      "rationale": "Selected comparable price and terrain-value objectives share the Value budget without defining a destination-wide default pass.",
      "intent": {
        "objectives": [
