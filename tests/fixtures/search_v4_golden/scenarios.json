      "expected_order": ["balanced-value", "large-expensive"],
      "expected_fit_ranges": {"balanced-value": [64.99, 65.01], "large-expensive": [59.99, 60.01]}
    },
    {
      "name": "travel_only_is_unscored",
      "rationale": "Travel Effort alone cannot consume 100 percent because its maximum share is 30 percent.",
      "intent": {},
      "candidates": [
        {"id": "travel-only", "evaluations": [{"factor_id": "travel_effort", "utility": 1}]}
